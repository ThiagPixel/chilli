# ============================================================================
# Chilli — env do Postgres (compartilhado por prod e staging).
#
# Copie para a VPS como /srv/chilli/secrets/postgres.env (chmod 600).
# NUNCA commitar — está no .gitignore.
#
# Os 2 envs do backend (prod e staging) usam o mesmo user/password,
# mas DATABASE_URL aponta para DBs diferentes (chilli e chilli_staging).
#
# Para gerar POSTGRES_PASSWORD:
#   openssl rand -base64 32
# ============================================================================

POSTGRES_USER=chilli
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
POSTGRES_DB=chilli
