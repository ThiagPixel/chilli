# Ambiente
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://chilli:chilli@localhost:5432/chilli

# Auth (JWT)
# Em produção, gere um valor aleatório >= 32 chars
JWT_SECRET=change-me-min-32-chars-please-1234567890
JWT_EXPIRES_IN=30d

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
