# ============================================================================
# Chilli — env de PRODUÇÃO.
#
# Copie para a VPS como /srv/chilli/app/backend/.env.prod (chmod 600).
# NUNCA commitar o arquivo real — só este template.
#
# Gerar JWT_SECRET:
#   openssl rand -base64 48
#
# DATABASE_URL: usuário e senha precisam bater com POSTGRES_USER/POSTGRES_PASSWORD
# em /srv/chilli/secrets/postgres.env. O DB "chilli" é criado pelo POSTGRES_DB
# no init do container; "chilli_staging" é criado pelo init script SQL.
# ============================================================================

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Banco de prod. O host "db" resolve via DNS do docker network chilli_prod_net.
DATABASE_URL=postgres://chilli:CHANGE_ME_DB_PASSWORD@db:5432/chilli

# Auth — gere um valor novo com `openssl rand -base64 48`.
JWT_SECRET=CHANGE_ME_min_32_chars_generate_with_openssl_rand_base64_48
JWT_EXPIRES_IN=30d

# Uploads.
UPLOAD_DIR=/uploads
MAX_UPLOAD_MB=10
