# ============================================================================
# Chilli — env de STAGING.
#
# Copie para a VPS como /srv/chilli/app/backend/.env.staging (chmod 600).
# NUNCA commitar o arquivo real — só este template.
#
# JWT_SECRET DEVE ser diferente do de produção.
# Senha do banco: a mesma de prod (mesmo POSTGRES_PASSWORD).
# ============================================================================

NODE_ENV=staging
PORT=3000
LOG_LEVEL=debug

# Banco de staging. Mesmo host (db) e usuário, mas DB diferente.
DATABASE_URL=postgres://chilli:CHANGE_ME_DB_PASSWORD@db:5432/chilli_staging

# Auth — DIFERENTE do de produção. Gere com `openssl rand -base64 48`.
JWT_SECRET=CHANGE_ME_staging_different_from_prod_min_32_chars_xxxxxxxxxxxxx
JWT_EXPIRES_IN=30d

# Uploads.
UPLOAD_DIR=/uploads
MAX_UPLOAD_MB=10
