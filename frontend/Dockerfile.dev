# Dev Dockerfile para o frontend — roda Vite com HMR.
# Não é o de produção (esse é o Dockerfile raiz).
FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund

COPY tsconfig.json vite.config.ts index.html ./
COPY public ./public
COPY src ./src

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
